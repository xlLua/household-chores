# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Google Cloud -> Credentials -> OAuth 2.0 Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Push notifications. Generate a pair with: npx web-push generate-vapid-keys
# The public key goes in both VITE_VAPID_PUBLIC_KEY (browser) and
# VAPID_PUBLIC_KEY (server). Everything below this line except the VITE_ one
# is server-only: set it in Vercel, never in the browser bundle.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-app.vercel.app
# Supabase -> Project Settings -> API -> service_role (bypasses RLS; keep secret)
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=
